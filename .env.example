# Common
APP_ENV=development
PROJECT_NAME=myapp
NAMESPACE=your-username
REGISTRY=ghcr.io

# Server
SERVER_PORT=8080
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=20s

# Database
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=testpasswrd02
DB_NAME=myappdb
DB_PORT=5432
DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?sslmode={DB_SSLMODE}
DB_SSLMODE=disable
DB_DRIVER=postgres

# JWT
JWT_SECRET=dev_secret
JWT_EXPIRATION=24h

# App
APP_PORT=3000
MEMORY_LIMIT=512M
CPU_LIMIT=0.5
MEMORY_RESERVE=256M
CPU_RESERVE=0.25
API_KEY=your_api_key

# Redis
REDIS_PASSWORD=redis123
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Production
REPLICAS=3
DOMAIN=myapp.com
GRAFANA_PASSWORD=secure_password
