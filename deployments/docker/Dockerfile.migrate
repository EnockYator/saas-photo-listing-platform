# Multi-stage build for minimal secure Go binary

# ============================================
# STAGE 1: Builder
# ============================================
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /build

# Enable Go modules and build settings
ENV GO111MODULE=on \
    CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64 \
    GOFLAGS="-buildvcs=false"

# Copy go mod files first for better layer caching
COPY go.mod go.sum ./
RUN go mod download && go mod verify

# Copy source code
COPY . .

ARG VERSION=dev
ARG BUILD_TIME

# Build the binary with optimizations
RUN go build -ldflags="-w -s -X main.version=${VERSION} -X main.buildTime=${BUILD_TIME}" \
    -o migrate ./cmd/migrate

# ============================================
# STAGE 2: Production Runner
# ============================================
FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata curl postgresql-client

# Create non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

# Set timezone (adjust as needed)
ENV TZ=EAT

WORKDIR /app

# Copy binary from builder
COPY --from=builder --chown=appuser:appgroup /build/migrate .

# Copy migrations from builder
COPY --from=builder --chown=appuser:appgroup /build/internal/infrastructure/database/postgres/migrations ./migrations

# Switch to non-root user
USER appuser

# Run the application
ENTRYPOINT ["./migrate"]
CMD ["up"]